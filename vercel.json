{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    {
      "src": "/(build|assets|vendor|favicon\\.ico|robots\\.txt)(.*)",
      "dest": "/public/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "QUEUE_CONNECTION": "sync",
    "LARAVEL_STORAGE_PATH": "/tmp/storage",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "APP_SERVICES_CACHE": "/tmp/storage/bootstrap/cache/services.php",
    "APP_PACKAGES_CACHE": "/tmp/storage/bootstrap/cache/packages.php",
    "APP_CONFIG_CACHE": "/tmp/storage/bootstrap/cache/config.php",
    "APP_ROUTES_CACHE": "/tmp/storage/bootstrap/cache/routes-v7.php",
    "APP_EVENTS_CACHE": "/tmp/storage/bootstrap/cache/events.php",
    "DB_CONNECTION": "pgsql",
    "DB_PORT": "6543",
    "DB_DATABASE": "postgres",
    "DB_USERNAME": "postgres.xjitcozbsbnxooqjavby",
    "DB_HOST": "aws-1-ap-southeast-1.pooler.supabase.com",
    "DB_SSLMODE": "require"
  },
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ]
}