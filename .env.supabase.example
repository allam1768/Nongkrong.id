# ========================================================
# CONTOH ENVIRONMENT VARIABLES UNTUK VERCEL + SUPABASE
# Copy seluruh isi ini ke menu:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# ========================================================

APP_NAME=NONGKRONG.id
APP_ENV=production
APP_KEY=base64:72jM20f1O0Fk9fP4n1d2e3A4B5C6D7E8F9G0H1I2J3K=
APP_DEBUG=false
APP_URL=https://your-subdomain.vercel.app

# Vercel Serverless Configurations (Wajib Cookie/Array karena Read-Only Filesystem)
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# Database: Supabase PostgreSQL (Wajib Transaction Pooler Port 6543)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_SUPABASE_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSLMODE=require

# Midtrans Gateway (QRIS Payment)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# AI Gemini API (Menu Recommendation Assistant)
GEMINI_API_KEY=
